# Alpaca API Configuration
# Get your keys at https://alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to 'paper' for paper trading or 'live' for real trading
# WARNING: Use 'live' only when you're ready to trade with real money
ALPACA_TRADING_MODE=paper

# Trading Configuration
# Risk per trade as decimal (0.005 = 0.5% of account)
RISK_PER_TRADE=0.005

# Maximum number of concurrent positions
MAX_POSITIONS=5

# Maximum allocation per position (as decimal of total equity)
MAX_POSITION_SIZE=0.20

# Scan interval in minutes (5-15 recommended)
SCAN_INTERVAL_MINUTES=5

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
